<?xml version="1.0" encoding="utf-8"?>
<screen>
    <styles>
        <style name="style_bar_bg" bg_color="0x242a26" bg_opa="100%" radius="4" />
        <style name="style_bar_indicator" bg_color="0x36e96f" bg_opa="100%" radius="4" />
    </styles>
    <view style_bg_color="0x101214" style_bg_opa="100%">
        <lv_image name="dashboard_background" src="img_w108_bg" width="100%" height="100%" inner_align="cover" />

        <lv_obj name="left_gauge_pod" width="500" height="500" align="left_mid" x="120" style_bg_opa="0%" style_border_width="0" style_pad_all="0">
            <lv_image name="left_dial_face" src="img_left_face" align="center" />
            <lv_image name="temperature_needle" src="img_orange_needle" align="center" pivot_x="12" pivot_y="180" rotation="-42" />
            <lv_image name="fuel_needle" src="img_orange_needle" align="center" pivot_x="12" pivot_y="180" rotation="22" />
            <lv_image name="oil_needle" src="img_orange_needle" align="center" pivot_x="12" pivot_y="180" rotation="99" />
            <lv_label name="check_engine_warning" align="center" y="140" text="CHECK ENGINE" style_text_color="0x55443b" />
            <lv_label name="brake_warning" align="center" x="-70" y="110" text="BRAKE" style_text_color="0x55443b" />
            <lv_label name="alternator_warning" align="center" x="70" y="110" text="GENER." style_text_color="0x55443b" />
            <lv_label name="water_temp_readout" align="bottom_left" x="16" y="-12" text="WATER 175F" style_text_color="0xe9e3d6" />
            <lv_label name="fuel_readout" align="bottom_mid" y="-12" text="FUEL 75%" style_text_color="0xe9e3d6" />
            <lv_label name="oil_readout" align="bottom_right" x="-16" y="-12" text="OIL 30 PSI" style_text_color="0xe9e3d6" />
        </lv_obj>

        <lv_obj name="speedometer_pod" width="500" height="500" align="right_mid" x="-120" style_bg_opa="0%" style_border_width="0" style_pad_all="0">
            <lv_image name="speedometer_dial_face" src="img_speedo_face" align="center" />
            <lv_image name="speedometer_needle" src="img_orange_needle" align="center" pivot_x="12" pivot_y="180" rotation="-42" />
            <lv_label name="speed_value" align="center" y="85" text="55 MPH" style_text_color="0xe9e3d6" />
            <lv_label name="odometer_value" align="center" y="-54" text="092107" style_text_color="0x111111" style_bg_color="0xe9e3d6" style_bg_opa="100%" style_pad_all="4" />
            <lv_label name="trip_value" align="center" y="-12" text="000.3" style_text_color="0x111111" style_bg_color="0xe9e3d6" style_bg_opa="100%" style_pad_all="4" />
        </lv_obj>

        <lv_image name="clock_face" src="img_clock_face" width="150" height="150" align="top_mid" y="30" />
        <lv_obj name="diagnostic_panel" width="280" height="170" align="bottom_mid" y="-34" style_bg_color="0x080c09" style_bg_opa="100%" style_border_color="0x87908a" style_border_width="2" style_radius="6" style_pad_all="12">
            <lv_label name="shift_label" align="top_left" text="ENGINE RPM" style_text_color="0xe9e3d6" />
            <lv_bar name="shift_bar" width="100%" height="18" align="top_mid" y="26" min_value="0" max_value="7000" value="2200">
                <style name="style_bar_bg" selector="main" />
                <style name="style_bar_indicator" selector="indicator" />
            </lv_bar>
            <lv_label name="rpm_value" align="top_right" y="50" text="2200 RPM" style_text_color="0xe9e3d6" />
            <lv_label name="can_diagnostics" align="bottom_left" width="100%" text="CAN ACTIVE&#10;SYS VOLT: 14.1V&#10;NO ERRORS" style_text_color="0x42ff75" />
        </lv_obj>
    </view>
</screen>
